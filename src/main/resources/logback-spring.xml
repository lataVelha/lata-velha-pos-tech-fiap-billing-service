<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="levelColorStart"
                     converterClass="br.com.lata.velha.shared.infrastructure.logging.LevelColorStartConverter"/>
    <conversionRule conversionWord="levelColorEnd"
                     converterClass="br.com.lata.velha.shared.infrastructure.logging.LevelColorEndConverter"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%levelColorStart%-5level [%X{trace_id:-N/A}] %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %C{0}.%M : %m%n%wEx%levelColorEnd"/>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"lata-velha-billing-service","env":"prod"}</customFields>
                <includeCallerData>true</includeCallerData>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

</configuration>
