# Copie para .env (não versionado) e preencha. O docker compose lê o .env automaticamente.

# Porta exposta no host (o container sempre escuta na 8081)
BILLING_PORT=8081

# Mercado Pago — use SEMPRE as Credenciais de TESTE (TEST-...) localmente.
# Painel: https://www.mercadopago.com.br/developers/panel/app → sua aplicação → Credenciais de teste
MERCADOPAGO_ACCESS_TOKEN=

# Chave secreta do painel → Webhooks. Vazio = validação do x-signature desligada (só dev)
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do webhook (ex.: ngrok): https://<id>.ngrok-free.app/pagamentos/webhook
MERCADOPAGO_NOTIFICATION_URL=

# Para onde o comprador volta após o checkout (opcionais)
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=
